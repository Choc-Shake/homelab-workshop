# Immich settings. Copy this file to ".env", then edit it.
# Based on the official example.env: https://github.com/immich-app/immich/releases/latest/download/example.env
# All supported variables: https://docs.immich.app/install/environment-variables

# Where your uploaded photos and videos are stored, as a folder next to compose.yaml
UPLOAD_LOCATION=./library

# Where the database is stored.
# "pgdata" is a Docker named volume (declared at the bottom of compose.yaml).
# The official default is ./postgres, which doesn't work in Windows folders.
DB_DATA_LOCATION=pgdata

# Your timezone
TZ=America/Edmonton

# Immich version. Pinned so updates only happen when you choose.
IMMICH_VERSION=v3.4.1

# Database password. Change it. Letters and numbers only.
DB_PASSWORD=postgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
